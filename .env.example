# Federato
FEDERATO_CLIENT_ID=
FEDERATO_CLIENT_SECRET=
FEDERATO_AUTH_URL=https://auth.product.federato.ai/oauth/token
FEDERATO_HANDLER_URL=https://product.federato.ai/integrations-api/handlers/federato-hack-north?outputOnly=true

# Baseten
AI_PROVIDER=openai
BASETEN_API_KEY=
BASETEN_OPENAI_BASE_URL=
BASETEN_FAST_MODEL=
BASETEN_REASONING_MODEL=
BASETEN_COMPILER_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_REVIEW_MODEL=gpt-5.6-terra
OPENAI_DEEP_MODEL=gpt-6-astra
OPENAI_MAX_RUN_USD=2.00
OPENAI_MAX_EVENT_USD=50.00
OPENAI_INPUT_COST_PER_MILLION_USD=0
OPENAI_OUTPUT_COST_PER_MILLION_USD=0

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=bindsight

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
